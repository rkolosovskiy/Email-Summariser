# Gmail API credentials
# Get these from Google Cloud Console: https://console.cloud.google.com/
# Create OAuth 2.0 credentials and download the JSON file
GMAIL_CREDENTIALS_PATH=credentials.json

# Gemini API key
# Get this from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail label to filter emails (default: INBOX)
GMAIL_LABEL=INBOX

# Maximum number of emails to process (default: 50)
MAX_EMAILS=50

# Focus topic for summary (default: AI)
FOCUS_TOPIC=AI

# Flask secret key for session management
# SEC Downloader User Agent (Required: "Name email@example.com")
SEC_USER_EMAIL=roman@example.com

# SEC Downloader User Agent (Required: "Name email@example.com")
SEC_USER_EMAIL=name@example.com

FLASK_SECRET_KEY=your_secret_key_here

# Optional: For Cloud Run deployment
# GMAIL_CLIENT_ID=your_client_id_here
# GMAIL_CLIENT_SECRET=your_client_secret_here
# GMAIL_REFRESH_TOKEN=your_refresh_token_here
